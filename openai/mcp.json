{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "humanpost": {
      "type": "streamable-http",
      "url": "https://humanpost.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://humanpost.com/mcp",
            "defaultScopes": [
              "accounts:read",
              "posts:read",
              "usage:read"
            ]
          }
        }
      }
    }
  }
}
